# What every bridge has. ESP-IDF adds the target's own file after this one (sdkconfig.defaults.esp32s3: 16 MB flash
# and octal PSRAM; sdkconfig.defaults.esp32c3: 4 MB, none). Add a board on top:
#   idf.py -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.w12" build
# Another target: idf.py set-target esp32c3 first (the S3 is the default).
CONFIG_IDF_TARGET="esp32s3"

# 1 ms ticks (the reader waits a tick at a time)
CONFIG_FREERTOS_HZ=1000
CONFIG_PARTITION_TABLE_CUSTOM=y

CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Wi-Fi: room for a 1.2 MB/s TCP stream out (the int8 rates); the network on core 0 with the reader above it.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_TX_BA_WIN=16
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_RX_BA_WIN=16
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_WND_DEFAULT=16384
CONFIG_LWIP_TCP_MSS=1436
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_LWIP_MAX_SOCKETS=10

# The HTTP status page and OTA (main/http.c)
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# FreeRTOS run-time stats: the status line gives the reader's share of core 0
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
