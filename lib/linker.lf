# The receive and transmit paths in IRAM (ESP-IDF): out of the cache that Wi-Fi and the PSRAM sample buffer share,
# so a cache miss never holds the reader past the FIFO. Static functions too: each has its own section. (The ESP-IDF
# HAL and port, both esp_idf.c, mark theirs IRAM_ATTR: two objects of one name confuse a fragment.)
[mapping:lr20xx]
archive: liblib.a
entries:
    lr20xx:wait_busy (noflash)
    lr20xx:xfer_rx (noflash)
    lr20xx:xfer (noflash)
    lr20xx:check (noflash)
    lr20xx:lr20xx_get_status (noflash)
    lr20xx:lr20xx_send (noflash)
    lr20xx:lr20xx_write (noflash)
    lr20xx:lr20xx_read (noflash)
    lr20xx:lr20xx_read_fifo (noflash)
    lr20xx:lr20xx_rx_fifo_level (noflash)
    lr20xx:lr20xx_fifo_flags_peek (noflash)
    lr20xx:lr20xx_tx_fifo_level (noflash)
    lr20xx:lr20xx_write_tx_fifo (noflash)
    lr20xx:lr20xx_irq (noflash)
    lr20xx:lr20xx_wait_irq (noflash)
    lr20xx:lr20xx_has_irq (noflash)
    lr20xx_cmd:put_op (noflash)
    lr20xx_cmd:put32 (noflash)
    lr20xx_cmd:lr20xx_cmd (noflash)
    lr20xx_cmd:lr20xx_status (noflash)
    lr20xx_cmd:lr20xx_cmd_clear_irq (noflash)
    lr20xx_cmd:lr20xx_cmd_clear_fifo_flags (noflash)
    lr20xx_iq:use_irq (noflash)
    lr20xx_iq:irq_level (noflash)
    lr20xx_iq:rearm (noflash)
    lr20xx_iq:drain (noflash)
    lr20xx_iq:lr20xx_iq_poll (noflash)
    lr20xx_tx_stream:lr20xx_tx_stream (noflash)
