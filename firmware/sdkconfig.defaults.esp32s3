# The ESP32-S3's defaults (ESP-IDF loads this after sdkconfig.defaults when the target is esp32s3): 16 MB flash and
# 8 MB octal PSRAM, as on the ESP32-S3-WROOM-1-N16R8 and the W12's ESP32-S3R8.

# Both cores at 240 MHz
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Octal PSRAM (takes GPIO35-37). A quad PSRAM part wants CONFIG_SPIRAM_MODE_QUAD=y instead. The sample ring and the
# transmit buffer live there; internal RAM is the SPI's DMA and the stacks.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
