# The ESP32-S3's defaults (ESP-IDF loads this after sdkconfig.defaults when the target is esp32s3): 16 MB flash and
# 8 MB octal PSRAM, as on the ESP32-S3-WROOM-1-N16R8 and the W12's ESP32-S3R8.

# Both cores at 240 MHz
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Octal PSRAM (takes GPIO35-37). A quad PSRAM part wants CONFIG_SPIRAM_MODE_QUAD=y instead. The sample ring and the
# transmit buffer live there; internal RAM is the SPI's DMA and the stacks.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# Wi-Fi at full speed (internal RAM has room on the S3): its buffers in internal RAM and its hot code in IRAM, out of
# the cache the PSRAM sample buffer shares; the buffer counts Espressif's iperf example uses. No A-MPDU out: a lost
# subframe held the frames behind it at the access point until TCP sent it again, a second later; one frame at a time
# carried 320 KB/s on a link where aggregation gave 80-200 KB/s.
# CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP is not set
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=y
CONFIG_LWIP_IRAM_OPTIMIZATION=y
CONFIG_LWIP_EXTRA_IRAM_OPTIMIZATION=y
# The SPI driver's and GPIO's calls in IRAM too, with the reader's own (lib/linker.lf)
CONFIG_SPI_MASTER_IN_IRAM=y
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_RX_BA_WIN=32
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65534
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
