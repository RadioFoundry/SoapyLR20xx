# The serial link on a TinyUSB CDC port (S2, S3). The native USB port becomes the link, so the console moves to
# UART0 (GPIO43 TX / GPIO44 RX on the S3; the W12 has it on pads only). On an S3, sdkconfig.defaults.ncm (the
# network over USB) is quicker. Layer it last:
#   -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.w12;sdkconfig.defaults.usb"
CONFIG_LR20XX_LINK_SERIAL=y
CONFIG_LR20XX_SERIAL_TINYUSB=y
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_CDC_RX_BUFSIZE=512
CONFIG_TINYUSB_CDC_TX_BUFSIZE=2048
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG is not set
